# PiarBot VK — настройки окружения
# Скопируй этот файл в .env и заполни своими значениями

# Токен сообщества VK (получить: Управление сообществом → Работа с API → Создать ключ)
VK_GROUP_TOKEN=your_group_token_here

# ID сообщества (число, положительное)
VK_GROUP_ID=123456789

# Короткое имя сообщества для ссылки https://vk.me/имя
VK_GROUP_SCREEN=go_gigi
